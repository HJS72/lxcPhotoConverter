APP_NAME=lxcPhotoConverter
API_PREFIX=/api
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////opt/lxc-photo-converter/backend/data/app.db
SOURCE_SHARES=/srv/import/share1,/srv/import/share2
DESTINATION_SHARE=/srv/export
FAILED_SHARE=/srv/failed
SCAN_INTERVAL_SECONDS=300
OBSERVER_RECURSIVE=true
EXIFTOOL_PATH=exiftool
MAGICK_PATH=magick
WORKER_COUNT=2
TIMEZONE=Europe/Berlin
